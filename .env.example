# Gemini API key: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=replace_with_your_key

# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Numeric user, group, or channel chat ID that should receive the digest
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Private Social Editor scheduled candidate submission
SOCIAL_EDITOR_URL=https://replace-with-your-worker.example
SOCIAL_EDITOR_JOB_TOKEN=replace_with_a_random_job_token
